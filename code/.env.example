GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=qwen/qwen3.6-27b
GROQ_MODEL_ASR=whisper-large-v3-turbo
LOG_LEVEL=INFO

# Paths are anchored to the repo root (for dataset/output) or code dir
# (for caches/artifacts/index/media_cache). Relative values resolve there.
DATASET_DIR=dataset
OUTPUT_PATH=dataset/output.csv
ARTIFACTS_DIR=artifacts
MEDIA_CACHE_DIR=.cache/media

# Groq free-tier pacing (per-minute)
MEDIA_RPM_VISION=10
MEDIA_RPM_ASR=20
MEDIA_RETRIES=2

# Retrieval / personalization
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.1
RETRIEVAL_RECENCY_DECAY_DAYS=60
PREFERENCE_MODEL_FALLBACK_THRESHOLD=0.5